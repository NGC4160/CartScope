# Environment variables for Neighborhood Golf Carts CartScope
#
# Copy to Vercel → Project → Settings → Environment Variables
# (Production + Preview). Do not commit real keys.

# Required for the shop helper. Server-only.
XAI_API_KEY=

# Required for shared case files (tablets + phones).
# Vercel → Storage → Create Database → Blob → connect to cart-scope
# (store name cart-scope-blob). The dashboard injects this token on
# Production / Preview. Do not invent or commit the token.
BLOB_READ_WRITE_TOKEN=

# Optional shop-brain filing of the redacted report copy.
# BRAIN_WEBHOOK_URL=
# BRAIN_WEBHOOK_SECRET=
